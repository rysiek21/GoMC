package main

import (
	"bufio"
	"bytes"
	"encoding/json"
	"fmt"
	"io"
	"log"
	"net"
	"os"

	"github.com/rysiek21/gomc/packet"
)

type ServerSettings struct {
	VersionName string `json:"versionName"`
	Protocol    string `json:"protocol"`
	Port        string `json:"port"`
	MOTD        string `json:"MOTD"`
	OnlineMode  bool   `json:"onlineMode"`
}

func main() {
	var settings ServerSettings
	loadSettings(&settings)
	log.Println("Starting TCP server")
	listener, err := net.Listen("tcp", ":"+settings.Port)
	if err != nil {
		panic(err)
	}
	defer listener.Close()
	for {
		conn, err := listener.Accept()
		if err != nil {
			log.Println("Failed to accept connection: ", err)
			continue
		}
		go connectionHandler(conn, settings)
	}
}

func loadSettings(settings *ServerSettings) {
	data, err := os.ReadFile("settings.json")
	if err != err {
		panic(err)
	}
	json.Unmarshal(data, settings)
}

func connectionHandler(conn net.Conn, settings ServerSettings) {
	defer conn.Close()
	reader := bufio.NewReader(conn)
	connectionState := packet.State(0)
	for {
		length, err := ReadVarInt(reader)
		if err != nil {
			return
		}
		packetData := make([]byte, length)
		_, err = io.ReadFull(reader, packetData)
		if err != nil {
			return
		}
		packetReader := bytes.NewReader(packetData)
		intPacketID, err := ReadVarInt(packetReader)
		if err != nil {
			return
		}
		packetID := packet.ID(intPacketID)

		switch connectionState {
		case packet.StateHandshaking:
			switch packetID {
			case packet.Handshake:
				log.Println("---- Received handshake packet ----")
				protocolVersion, _ := ReadVarInt(packetReader)
				serverAddress, _ := ReadString(packetReader)
				serverPort, _ := ReadUnsignedShort(packetReader)
				nextState, _ := ReadVarInt(packetReader)
				log.Printf("P-ver: %d, Address: %s, Port: %d, Next State: %d\n", protocolVersion, serverAddress, serverPort, nextState)
				if nextState == 1 {
					connectionState = packet.StateStatus
				} else {
					connectionState = packet.StateLogin
				}
			default:
				log.Printf("Unknown packet in handshake state! Length: %d, Type: %d\n", length, packetID)
			}
		case packet.StateStatus:
			switch packetID {
			case packet.StatusRequest:
				statusString := fmt.Sprintf(`{"version":{"name":"%s","protocol":%s},"description":{"text":"%s"},"enforcesSecureChat":false}`, settings.VersionName, settings.Protocol, settings.MOTD)
				var response []byte
				response = append(response, MakeVarInt(0x00)...)
				response = append(response, MakeString(statusString)...)
				response = append(MakeVarInt(len(response)), response...)
				conn.Write(response)
			case packet.StatusPing:
				timestamp, _ := ReadLong(packetReader)
				var response []byte
				response = append(response, MakeVarInt(0x1)...)
				response = append(response, MakeLong(timestamp)...)
				response = append(MakeVarInt(len(response)), response...)
				conn.Write(response)
			default:
				log.Printf("Unknown packet in status state! Length: %d, Type: %d\n", length, packetID)
			}
		case packet.StateLogin:
			switch packetID {
			case packet.LoginHello:
				playerName, _ := ReadString(packetReader)
				playerUUID, _ := ReadUUID(packetReader)
				if settings.OnlineMode == false {
					playerUUID = GenerateOfflineUUID(playerName)
				}
				log.Printf("%s is connecting. UUID: %s\n", playerName, playerUUID.String())
				// Login Success
				var response []byte
				response = append(response, MakeVarInt(0x02)...)
				response = append(response, playerUUID[:]...)
				response = append(response, MakeString(playerName)...)
				response = append(response, MakeVarInt(0x0)...)
				response = append(response, playerUUID[:]...)
				response = append(MakeVarInt(len(response)), response...)
				conn.Write(response)
			case packet.LoginAcknowledged:
				log.Println("Login Acknowledged")
				connectionState = packet.StateConfiguration
			default:
				log.Printf("Unknown packet in login state! Length: %d, Type: %d\n", length, packetID)
			}
		case packet.StateConfiguration:
			switch packetID {
			case packet.ConfigurationClientInfo:
				locale, _ := ReadString(packetReader)
				fmt.Println(locale)
			default:
				log.Printf("Unknown packet in configuration state! Length: %d, Type: %d\n", length, packetID)
			}
		}
	}
}
